# 专属连接由初始化生成；容器通过 WORKBENCH_DB_* 连接现有数据库。
DATABASE_URL=postgresql://mywork_home_app:填写专属密码@127.0.0.1:5432/mywork_home
WORKBENCH_DB_NAME=mywork_home
WORKBENCH_DB_USER=mywork_home_app
WORKBENCH_DB_PASSWORD=
WORKBENCH_DB_HOST=host.docker.internal
WORKBENCH_DB_PORT=5432
WORKBENCH_LLM_API_KEY=
WORKBENCH_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
WORKBENCH_LLM_MODEL=glm-5.3-flash
WORKBENCH_SYNC_CONCURRENCY=3
SYNC_INTERVAL_MS=600000
SYNC_ENABLED=true
# 下列变量可按本机路径设置；Compose 只读挂载这些目录。
# CODEX_SESSIONS_DIR=/Users/你的用户名/.codex/sessions
# CODEX_ARCHIVE_DIR=/Users/你的用户名/.codex/archived_sessions
# CLAUDE_PROJECTS_DIR=/Users/你的用户名/.claude/projects
# WORKBUDDY_PROJECTS_DIR=/Users/你的用户名/.workbuddy/projects
# ZCODE_DB_DIR=/Users/你的用户名/.zcode/cli/db
